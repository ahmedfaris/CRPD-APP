# =============================================================================
# Local Server & Production PostgreSQL Configuration
# =============================================================================

# Server Port (Default is 3000)
PORT=3000
NODE_ENV=production

# JWT Authentication Secret Key (Generate a random 32+ character string in production)
# REQUIRED in production (server refuses to start without it): at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-very-strong-and-secure-random-jwt-key-2026"

# Set to "true" only when running behind a trusted reverse proxy (nginx, IIS, load balancer)
# so the login rate limiter uses the real client IP from X-Forwarded-For.
TRUST_PROXY="false"

# -----------------------------------------------------------------------------
# PostgreSQL Database Connection Options
# -----------------------------------------------------------------------------
# Option A: Full Connection String URI
DATABASE_URL="postgres://postgres:your_secure_password@localhost:5432/itsm_db"

# Option B: Individual Connection Parameters
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="your_secure_password"
SQL_DB_NAME="itsm_db"

# Connection Pooling & SSL Settings
DB_POOL_MAX=10
DATABASE_SSL="false"
DATABASE_SSL_REJECT_UNAUTHORIZED="false"

# Optional: Set to true only if you want embedded in-memory fallback instead of PostgreSQL
USE_PGLITE="false"

# -----------------------------------------------------------------------------
# Optional Integrations
# -----------------------------------------------------------------------------
# Optional: External Serilog / SIEM endpoint for centralized audit logging
# SERILOG_API_URL="https://your-log-collector.local/api/logs"
# SERILOG_API_KEY=""

# Optional: Gemini API Key (if AI assistance features are enabled)
# GEMINI_API_KEY=""
