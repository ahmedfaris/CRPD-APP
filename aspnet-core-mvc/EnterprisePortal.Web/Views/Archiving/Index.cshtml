@model List<EnterprisePortal.Web.Models.ArchivalDocument>
@{
    ViewData["Title"] = "Digital Archiving Vault";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-6 border-b border-slate-800 gap-4">
        <div>
            <h1 class="text-2xl font-black text-white flex items-center space-x-3">
                <i class="fa-solid fa-box-archive text-emerald-400"></i>
                <span>Digital Archiving & Records Vault</span>
            </h1>
            <p class="text-xs text-slate-400 mt-1">Legally compliant archiving with QR barcode verification and SHA-256 seals.</p>
        </div>
        <a asp-action="Create" class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-lg shadow-emerald-600/30 transition">
            <i class="fa-solid fa-file-arrow-up"></i>
            <span>Archive New Document</span>
        </a>
    </div>

    <!-- Grid of Archive Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var doc in Model)
        {
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-emerald-500/50 transition flex flex-col justify-between shadow-lg">
                <div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="font-mono text-emerald-400 font-bold">@doc.DocumentNumber</span>
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-300">@doc.Confidentiality</span>
                    </div>
                    <h3 class="text-base font-bold text-white mt-3 line-clamp-2">@doc.Title</h3>
                    <p class="text-xs text-slate-400 mt-2 line-clamp-3">@doc.Summary</p>

                    <div class="mt-4 pt-4 border-t border-slate-800 space-y-1.5 text-xs text-slate-400">
                        <div class="flex justify-between">
                            <span class="text-slate-500">Physical Vault:</span>
                            <span class="font-medium text-slate-300 truncate max-w-[180px]">@doc.PhysicalLocation</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Barcode:</span>
                            <span class="font-mono text-cyan-400">@doc.BarcodeNumber</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Retention:</span>
                            <span>@doc.RetentionYears Years (@doc.FileType)</span>
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-4 border-t border-slate-800/80 flex items-center justify-between">
                    <span class="text-[11px] text-emerald-400 font-mono flex items-center space-x-1">
                        <i class="fa-solid fa-certificate"></i>
                        <span>SHA-256 Validated</span>
                    </span>
                    <a asp-action="Details" asp-route-id="@doc.Id" class="px-3 py-1.5 rounded-lg bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 text-xs font-bold transition">
                        View QR & Specs
                    </a>
                </div>
            </div>
        }
    </div>
</div>
