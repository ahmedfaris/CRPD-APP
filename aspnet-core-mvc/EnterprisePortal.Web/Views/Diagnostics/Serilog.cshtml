@{
    ViewData["Title"] = "Serilog Audit Sinks";
    var logs = ViewBag.LogLines as List<string> ?? new List<string>();
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-6 border-b border-slate-800 gap-4">
        <div>
            <h1 class="text-2xl font-black text-white flex items-center space-x-3">
                <i class="fa-solid fa-terminal text-amber-400"></i>
                <span>Serilog Diagnostic Event Sink</span>
            </h1>
            <p class="text-xs text-slate-400 mt-1">Real-time structured rolling log files read directly from <code class="text-amber-300">/Logs/enterprise_audit-*.txt</code></p>
        </div>
        <div class="flex items-center space-x-3">
            <a asp-action="Serilog" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold transition flex items-center space-x-2">
                <i class="fa-solid fa-rotate-right"></i>
                <span>Refresh Log Sink</span>
            </a>
        </div>
    </div>

    <!-- Terminal Console Log Viewer -->
    <div class="rounded-2xl border border-slate-800 bg-slate-950 p-6 shadow-2xl font-mono text-xs overflow-hidden">
        <div class="flex items-center justify-between pb-4 border-b border-slate-800/80 mb-4 text-slate-400">
            <div class="flex items-center space-x-2">
                <span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>
                <span class="ml-3 text-[11px] font-bold text-slate-300">enterprise_audit.log</span>
            </div>
            <span class="text-[11px] text-slate-500">@logs.Count Recent Entries</span>
        </div>

        <div class="space-y-1.5 max-h-[600px] overflow-y-auto pr-2">
            @if (!logs.Any())
            {
                <div class="text-slate-500 py-8 text-center">No log records collected in the active rolling file yet. Log events will stream here automatically.</div>
            }
            @foreach (var line in logs)
            {
                string colorClass = "text-slate-300";
                if (line.Contains("[ERR]") || line.Contains("[FTL]"))
                {
                    colorClass = "text-red-400 bg-red-950/20 px-2 py-0.5 rounded";
                }
                else if (line.Contains("[WRN]"))
                {
                    colorClass = "text-amber-300 bg-amber-950/20 px-2 py-0.5 rounded";
                }
                else if (line.Contains("SecurityPolicy") || line.Contains("DirectLogin"))
                {
                    colorClass = "text-cyan-300 font-semibold";
                }

                <div class="@colorClass whitespace-pre-wrap break-all leading-relaxed hover:bg-slate-900/80 px-1 py-0.5 rounded">
                    @line
                </div>
            }
        </div>
    </div>
</div>
