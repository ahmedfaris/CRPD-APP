<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise Operations Hub</title>
    <!-- Tailwind CSS CDN for instant styling without local node builds -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        .metro-tile {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .metro-tile:hover {
            transform: translateY(-3px);
        }
    </style>
</head>
<body class="h-full flex flex-col font-sans bg-slate-950 text-slate-100 antialiased selection:bg-blue-600 selection:text-white">

    <!-- Top Metro Navigation Bar -->
    <header class="bg-slate-900/90 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-6">
                <a asp-controller="Metro" asp-action="Index" class="flex items-center space-x-3 text-white font-black tracking-tight group">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center shadow-lg shadow-blue-500/20 group-hover:scale-105 transition">
                        <i class="fa-solid fa-shapes text-white text-lg"></i>
                    </div>
                    <div class="leading-tight">
                        <span class="text-base font-extrabold text-white block">ENTERPRISE HUB</span>
                        <span class="text-[10px] text-blue-400 font-mono font-semibold tracking-wider uppercase block">ASP.NET Core MVC 8.0</span>
                    </div>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <nav class="hidden md:flex items-center space-x-1 text-sm font-medium text-slate-300">
                        <a asp-controller="Metro" asp-action="Index" class="px-3 py-1.5 rounded-lg hover:bg-slate-800 hover:text-white transition">
                            <i class="fa-solid fa-table-cells-large mr-1.5 text-blue-400"></i> Hub
                        </a>
                        <a asp-controller="Tickets" asp-action="Index" class="px-3 py-1.5 rounded-lg hover:bg-slate-800 hover:text-white transition">
                            <i class="fa-solid fa-ticket mr-1.5 text-indigo-400"></i> Tickets
                        </a>
                        <a asp-controller="Archiving" asp-action="Index" class="px-3 py-1.5 rounded-lg hover:bg-slate-800 hover:text-white transition">
                            <i class="fa-solid fa-box-archive mr-1.5 text-emerald-400"></i> Archiving
                        </a>
                        <a asp-controller="Employees" asp-action="Index" class="px-3 py-1.5 rounded-lg hover:bg-slate-800 hover:text-white transition">
                            <i class="fa-solid fa-users mr-1.5 text-purple-400"></i> Staff
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="UserPolicy" asp-action="Index" class="px-3 py-1.5 rounded-lg hover:bg-slate-800 hover:text-cyan-300 transition">
                                <i class="fa-solid fa-sliders mr-1.5 text-cyan-400"></i> Policy & 2FA
                            </a>
                            <a asp-controller="Diagnostics" asp-action="Serilog" class="px-3 py-1.5 rounded-lg hover:bg-slate-800 hover:text-amber-300 transition">
                                <i class="fa-solid fa-terminal mr-1.5 text-amber-400"></i> Serilog
                            </a>
                        }
                    </nav>
                }
            </div>

            <div class="flex items-center space-x-4">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="hidden sm:flex items-center space-x-3 text-right">
                        <div>
                            <div class="text-xs font-bold text-white">@User.Identity.Name</div>
                            <div class="text-[10px] font-mono text-emerald-400 flex items-center justify-end space-x-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span>Authenticated</span>
                            </div>
                        </div>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        <button type="submit" class="px-3 py-1.5 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 text-xs font-semibold transition flex items-center space-x-1.5">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            <span>Sign Out</span>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition shadow-md shadow-blue-600/30">
                        Sign In
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Flash Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-emerald-950/80 border-b border-emerald-800 text-emerald-300 px-4 py-2.5 text-center text-sm font-semibold flex items-center justify-center space-x-2">
            <i class="fa-solid fa-circle-check text-emerald-400"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- Main Container -->
    <main class="flex-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 py-4 text-center text-xs text-slate-500">
        <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between space-y-2 sm:space-y-0">
            <div>
                <span>Enterprise Portal ASP.NET Core MVC • Powered by .NET 8, EF Core, Serilog & RFC 6238 TOTP</span>
            </div>
            <div class="flex items-center space-x-4">
                <span class="text-slate-400 font-mono">Environment: Production</span>
                <a asp-controller="Diagnostics" asp-action="Serilog" class="hover:text-blue-400 transition">Audit Logs</a>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
