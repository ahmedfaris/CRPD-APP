<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise Ticket System</title>
    <!-- Add Bootstrap or Tailwind here -->
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Tickets" asp-action="Index">Tickets Dashboard</a>
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole("System Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Teams" asp-action="Index">Teams Management</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="MetroDashboard" asp-action="Index">Metro Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="TicketStages" asp-action="Index">Ticket Stages</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="SLA" asp-action="Index">SLA Management</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- SignalR script -->
    <script src="~/lib/signalr/dist/browser/signalr.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/ticketHub")
            .build();

        connection.on("ReceiveTicketNotification", function (message) {
            alert(message); // Could be replaced with a toast notification
        });

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
